# Copy to .env (or export these in your shell / IDE run configuration).
# .env and .env.* are git-ignored except this file — never commit real values.

# --- Backend: Spring profile ---------------------------------------------
# One of: dev, prod. Never defaults — startup fails loudly if unset,
# by design, so a real environment is always chosen explicitly.
SPRING_PROFILES_ACTIVE=dev

# --- Backend: DEV database (existing Supabase project) --------------------
DEV_DB_URL=jdbc:postgresql://<dev-host>:5432/<dev-db>
DEV_DB_USERNAME=<dev-username>
DEV_DB_PASSWORD=<dev-password>

# --- Backend: PROD database (new Supabase project) -------------------------
PROD_DB_URL=jdbc:postgresql://<prod-host>:5432/<prod-db>
PROD_DB_USERNAME=<prod-username>
PROD_DB_PASSWORD=<prod-password>

# --- Backend: temporary dev-only auth stub ---------------------------------
# UUID of a row that already exists in the DEV Supabase project's auth.users.
# Only used by the dev profile; must be replaced by real Supabase JWT auth
# before a prod deployment is meaningful.
APP_DEV_USER_ID=<uuid-from-dev-auth-users>

# --- Frontend (optional; defaults to http://localhost:8080 if unset) ------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
