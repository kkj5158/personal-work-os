# Copy to .env (or export these in your shell / IDE run configuration).
# .env and .env.* are git-ignored except this file — never commit real values.

# --- Backend: Spring profile ---------------------------------------------
# One of: dev, prod. Never defaults — startup fails loudly if unset,
# by design, so a real environment is always chosen explicitly.
SPRING_PROFILES_ACTIVE=dev

# --- Backend: DEV database (existing Supabase project) --------------------
DEV_DB_URL=jdbc:postgresql://<dev-host>:5432/<dev-db>
DEV_DB_USERNAME=<dev-username>
DEV_DB_PASSWORD=<dev-password>

# --- Backend: PROD database (new Supabase project) -------------------------
PROD_DB_URL=jdbc:postgresql://<prod-host>:5432/<prod-db>
PROD_DB_USERNAME=<prod-username>
PROD_DB_PASSWORD=<prod-password>

# --- Backend: temporary dev-only auth stub ---------------------------------
# UUID of a row that already exists in the DEV Supabase project's auth.users.
# Only used by the dev profile (DevCurrentUserProvider, @Profile("dev"));
# never read by the prod profile, which authenticates via Supabase JWT
# instead (see ProdCurrentUserProvider / ProdSecurityConfig).
APP_DEV_USER_ID=<uuid-from-dev-auth-users>

# --- Backend: prod-only Supabase JWT verification ---------------------------
# The PROD Supabase project's JWKS endpoint (asymmetric ES256 signing keys),
# used to verify the signature of every incoming Authorization: Bearer JWT.
# Typically "<prod-supabase-url>/auth/v1/.well-known/jwks.json".
SUPABASE_JWKS_URI=<prod-supabase-jwks-uri>
# The JWT "iss" claim every token from that project carries — validated
# alongside signature and expiration. Typically "<prod-supabase-url>/auth/v1".
SUPABASE_JWT_ISSUER=<prod-supabase-issuer>

# --- Backend: prod-only CORS -------------------------------------------------
# Comma-separated list of origins allowed to call the prod API — the
# deployed frontend's real origin(s). Never hardcoded in ProdSecurityConfig.
APP_CORS_ALLOWED_ORIGINS=<prod-frontend-origin>

# --- Frontend (optional; defaults to http://localhost:8080 if unset) ------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Frontend: environment flag (dev keeps the no-login convenience; only
# "prod" enforces the Supabase Auth login gate) -----------------------------
NEXT_PUBLIC_APP_ENV=dev

# --- Frontend: Supabase Auth (prod only — the anon/publishable key is safe
# to expose client-side; never put the service_role/secret key here) -------
NEXT_PUBLIC_SUPABASE_URL=<prod-supabase-url>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<prod-supabase-publishable-key>
