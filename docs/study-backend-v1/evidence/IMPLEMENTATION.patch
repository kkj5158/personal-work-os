+    multi.set("response", parse("{\"selected\":[]}"));
+    cmd("draft.save", multi);
+    assertThat(study.snapshot().path("drafts")).isEmpty();
+    multi.set("response", parse("{\"selected\":[\"A\",\"A\"]}"));
