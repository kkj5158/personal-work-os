+
+  ObjectNode envelope(String action, JsonNode data) {
+    return JSON.createObjectNode()
+        .put("operationId", UUID.randomUUID().toString())
+        .put("expectedRevision", study.snapshot().path("revision").asLong())
+        .put("action", action)
+        .set("data", data);
